{
  "name": "bauhaus-ui-library",
  "version": "0.2.0-dev.2",
  "description": "A bold, geometric React component library inspired by the Bauhaus movement.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "react",
    "ui",
    "component-library",
    "bauhaus",
    "tailwind",
    "design-system",
    "dark-mode"
  ],
  "author": "Xhulio Lavdari",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xhu96/bauhaus-ui-library.git"
  },
  "homepage": "https://xhu96.github.io/bauhaus-ui-library/",
  "bugs": {
    "url": "https://github.com/xhu96/bauhaus-ui-library/issues"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/bauhaus-ui.cjs",
  "module": "./dist/bauhaus-ui.js",
  "unpkg": "./dist/bauhaus-ui.umd.cjs",
  "jsdelivr": "./dist/bauhaus-ui.umd.cjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/bauhaus-ui.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/bauhaus-ui.cjs"
      }
    },
    "./umd": "./dist/bauhaus-ui.umd.cjs",
    "./styles.css": "./dist/style.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:lib": "tsc --noEmit && vite build --config vite.lib.config.ts && vite build --config vite.umd.config.ts && node scripts/finalize-package.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "typecheck:browser": "tsc --noEmit --skipLibCheck --target ES2022 --module NodeNext --moduleResolution NodeNext tests/browser/playwright.config.ts tests/browser/consumer.spec.ts tests/browser/showcase.config.ts tests/browser/showcase.spec.ts tests/browser/hero.spec.ts tests/browser/bau.spec.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:catalog": "BUI_REQUIRE_CATALOG=1 vitest run src/site/catalog.test.ts",
    "api:check": "api-extractor run",
    "api:update": "npm run build:lib && api-extractor run --local",
    "package:smoke": "node scripts/package-smoke.mjs",
    "test:browser": "playwright test --config tests/browser/playwright.config.ts",
    "test:showcase": "playwright test --config tests/browser/showcase.config.ts",
    "test:pages": "node --test tests/pages/assembly.test.mjs",
    "pages:assemble": "node scripts/assemble-pages.mjs",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "prepack": "npm run build:lib"
  },
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^0.408.0",
    "tabbable": "^6.5.0",
    "tailwind-merge": "^2.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@microsoft/api-extractor": "^7.59.0",
    "@playwright/test": "^1.63.0",
    "@storybook/addon-a11y": "^10.5.10",
    "@storybook/addon-docs": "^10.5.10",
    "@storybook/react": "^10.5.10",
    "@storybook/react-vite": "^10.5.10",
    "@tailwindcss/oxide": "4.3.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20.19.43",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.4.19",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^17.6.0",
    "jsdom": "^24.1.3",
    "lightningcss": "1.32.0",
    "postcss": "^8.4.39",
    "postcss-selector-parser": "7.1.6",
    "prettier": "^3.8.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "storybook": "^10.5.10",
    "tailwindcss": "4.3.3",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.61.1",
    "vite": "^6.4.3",
    "vite-plugin-dts": "^5.0.3",
    "vitest": "^4.1.11"
  }
}
